{
	"name": "node-api",
	"version": "1.0.0",
	"description": "Node.js API for the Interseguro technical challenge.",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "rm -rf dist && tsc",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests --exclude 'dist/**'",
		"test:watch": "vitest --passWithNoTests --exclude 'dist/**'",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format ."
	},
	"type": "module",
	"dependencies": {
		"express": "^5.2.1",
		"helmet": "^8.3.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/express": "^5.0.6",
		"@types/node": "^26.5.0",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.2.2",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	}
}
